{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["vite/client", "@webgpu/types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "pixi.js": ["../../lib/index.d.ts"],
      "pixi.js/events": ["../../lib/events/init.d.ts"]
    }
  },
  "include": ["src"]
}
